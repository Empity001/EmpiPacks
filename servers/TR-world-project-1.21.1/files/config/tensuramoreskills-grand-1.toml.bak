		#Maximum targets hit by the single cube impact burst.
		# Default: 10
		# Range: > 1
		cubeJudgementSingleMaxImpactTargets = 10
		#Maximum targets hit by each rain cube impact burst.
		# Default: 4
		# Range: > 1
		cubeJudgementRainMaxImpactTargets = 4

