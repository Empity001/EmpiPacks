#Grand balance config for Tensura More Skills. All major obtainment, cost, cooldown, range, duration, damage, revive, and multiplier values should live here instead of being hardcoded inside skills. TO NAVIGATE THE CONFIG PRESS CONTROL+F THEN TYPE THE WANTED SKILL
[witch_of_vainglory]

	#Obtainment settings for Witch of Vainglory.
	[witch_of_vainglory.obtainment]
		#Magicule cost required to naturally acquire the skill. Set to 0 for no MP cost.
		# Default: 300000.0
		# Range: 0.0 ~ 1.7976931348623157E308
		acquirementMagiculeCost = 300000.0
		#Starting mastery value when acquired. 0 means no starting mastery.
		# Default: 0
		# Range: > -1
		acquirementMastery = 0
		#Required skill registry ID for obtainment. Empty string disables the required skill check.
		requiredSkillId = "tensura:tuner"
		#If true, the required skill must be mastered before Witch of Vainglory can be acquired.
		requiredSkillMustBeMastered = true

	#General passive and toggle settings.
	[witch_of_vainglory.general]
		#Radius of the toggled reality aura around the user.
		# Default: 4.0
		# Range: 0.0 ~ 128.0
		realityAuraRadius = 4.0
		#Duration applied to enemies hit by the toggled aura. 20 ticks = 1 second.
		# Default: 100
		# Range: 1 ~ 72000
		auraEffectDurationTicks = 100
		#How often the toggled aura reapplies its effect. Higher is better for performance. 80 ticks = 4 seconds.
		# Default: 80
		# Range: 1 ~ 72000
		auraEffectRefreshIntervalTicks = 80

	#Magicule costs for each active mode.
	[witch_of_vainglory.costs]
		#Magicule cost for Reality Change.
		# Default: 60000
		# Range: > 0
		realityChangeCost = 60000
		#Magicule cost for Deleted Timeline.
		# Default: 40000
		# Range: > 0
		deletedTimelineCost = 40000
		#Magicule cost for False Perception.
		# Default: 50000
		# Range: > 0
		falsePerceptionCost = 50000
		#Magicule cost for You Were Never Here.
		# Default: 70000
		# Range: > 0
		neverHereCost = 70000

	#Cooldowns for each mode. 20 ticks = 1 second.
	[witch_of_vainglory.cooldowns]
		#Cooldown after casting Reality Change.
		# Default: 120
		# Range: > 0
		realityChangeCooldownTicks = 120
		#Small cooldown after preparing Deleted Timeline before it reflects damage.
		# Default: 20
		# Range: > 0
		deletedTimelineReadyCooldownTicks = 20
		#Cooldown after Deleted Timeline successfully reflects damage or reverses a projectile.
		# Default: 160
		# Range: > 0
		deletedTimelineTriggeredCooldownTicks = 160
		#Cooldown after casting False Perception.
		# Default: 120
		# Range: > 0
		falsePerceptionCooldownTicks = 120
		#Cooldown after casting You Were Never Here.
		# Default: 240
		# Range: > 0
		neverHereCooldownTicks = 240
		#Cooldown applied to all modes after the death rewrite revive triggers.
		# Default: 1800
		# Range: > 0
		rewrittenCooldownTicks = 1800

	#Core duration values. 20 ticks = 1 second.
	[witch_of_vainglory.durations]
		#Duration of Reality Change's self-buff state.
		# Default: 200
		# Range: > 1
		realityCoatDurationTicks = 200
		#Duration of Deleted Timeline's counter window.
		# Default: 60
		# Range: > 1
		counterDurationTicks = 60
		#Duration of False Perception effects.
		# Default: 160
		# Range: > 1
		falsePerceptionDurationTicks = 160

	#Area and range values.
	[witch_of_vainglory.ranges]
		#Radius of False Perception around the caster.
		# Default: 16
		# Range: 0 ~ 128
		falsePerceptionRadius = 16
		#Radius of You Were Never Here around the caster.
		# Default: 24
		# Range: 0 ~ 128
		neverHereRadius = 24
		#Radius of the Reality Change burst knockback and confusion.
		# Default: 5.0
		# Range: 0.0 ~ 128.0
		realityChangeBurstRadius = 5.0
		#Radius where Reality Change deletes nearby projectiles.
		# Default: 5.0
		# Range: 0.0 ~ 128.0
		realityChangeProjectileClearRadius = 5.0

	#Reality Change balance values.
	[witch_of_vainglory.reality_change]
		#Knockback strength applied by the Reality Change burst.
		# Default: 1.4
		# Range: 0.0 ~ 64.0
		realityChangeKnockback = 1.4
		#Confusion duration applied by Reality Change.
		# Default: 80
		# Range: > 1
		realityChangeConfusionTicks = 80
		#Confusion amplifier applied by Reality Change. 0 means level 1.
		# Default: 0
		# Range: 0 ~ 255
		realityChangeConfusionAmplifier = 0
		#Resistance amplifier during Reality Coat. 0 means level 1.
		# Default: 2
		# Range: 0 ~ 255
		realityCoatResistanceAmplifier = 2
		#Strength amplifier during Reality Coat. 0 means level 1.
		# Default: 1
		# Range: 0 ~ 255
		realityCoatStrengthAmplifier = 1
		#Speed amplifier during Reality Coat. 0 means level 1.
		# Default: 1
		# Range: 0 ~ 255
		realityCoatSpeedAmplifier = 1
		#Self Regeneration amplifier during Reality Coat. 0 means level 1.
		# Default: 1
		# Range: 0 ~ 255
		realityCoatRegenerationAmplifier = 1
		#Duration of each refreshed Reality Coat effect application.
		# Default: 100
		# Range: > 1
		realityCoatEffectDurationTicks = 100
		#How often Reality Coat refreshes its buffs. Higher is better for performance.
		# Default: 80
		# Range: > 1
		realityCoatEffectRefreshIntervalTicks = 80

	#Deleted Timeline counter and projectile reversal values.
	[witch_of_vainglory.deleted_timeline]
		#Resistance amplifier while Deleted Timeline is waiting to counter. 0 means level 1.
		# Default: 1
		# Range: 0 ~ 255
		counterResistanceAmplifier = 1
		#Damage reflection multiplier. Reflected damage = incoming damage multiplied by this value.
		# Default: 1.75
		# Range: 0.0 ~ 1024.0
		counterReflectMultiplier = 1.75
		#Minimum reflected damage dealt by Deleted Timeline.
		# Default: 1.0
		# Range: 0.0 ~ 3.4028234663852886E38
		counterReflectMinimumDamage = 1.0
		#Minimum speed given to a reversed projectile.
		# Default: 1.5
		# Range: 0.0 ~ 128.0
		projectileReverseMinimumSpeed = 1.5
		#Speed used when a projectile has almost no movement and needs a fallback direction.
		# Default: 1.5
		# Range: 0.0 ~ 128.0
		projectileReverseFallbackSpeed = 1.5

	#False Perception illusion and displacement values.
	[witch_of_vainglory.false_perception]
		#Random teleport spread for affected targets. Higher values scatter targets further.
		# Default: 2.5
		# Range: 0.0 ~ 64.0
		falsePerceptionTeleportSpread = 2.5
		#Yaw rotation applied while a target remains under False Perception.
		# Default: 22.5
		# Range: -360.0 ~ 360.0
		falsePerceptionYawRotation = 22.5
		#Flashed Blindness amplifier. 0 means level 1.
		# Default: 0
		# Range: 0 ~ 255
		falsePerceptionBlindnessAmplifier = 0
		#Confusion amplifier. 0 means level 1.
		# Default: 0
		# Range: 0 ~ 255
		falsePerceptionConfusionAmplifier = 0
		#Movement Interference amplifier. 0 means level 1.
		# Default: 0
		# Range: 0 ~ 255
		falsePerceptionMovementInterferenceAmplifier = 0

	#Death rewrite revive values.
	[witch_of_vainglory.rewritten_death]
		#Maximum number of death rewrites per Minecraft day.
		# Default: 3
		# Range: > 0
		maxRevivesPerDay = 3
		#Health restored on revive as a percentage of max health. 0.6 = 60%.
		# Default: 0.6
		# Range: 0.0 ~ 1.0
		reviveHealthRatio = 0.6
		#Minimum health restored by revive, even if the percentage would be lower.
		# Default: 20.0
		# Range: 0.0 ~ 3.4028234663852886E38
		reviveMinimumHealth = 20.0
		#Invulnerability ticks after revive.
		# Default: 80
		# Range: > 0
		reviveInvulnerabilityTicks = 80
		#Resistance duration after revive.
		# Default: 100
		# Range: > 1
		reviveResistanceTicks = 100
		#Resistance amplifier after revive. 0 means level 1.
		# Default: 4
		# Range: 0 ~ 255
		reviveResistanceAmplifier = 4
		#Self Regeneration duration after revive.
		# Default: 200
		# Range: > 1
		reviveRegenerationTicks = 200
		#Self Regeneration amplifier after revive. 0 means level 1.
		# Default: 1
		# Range: 0 ~ 255
		reviveRegenerationAmplifier = 1
		#Haki Coat duration after revive.
		# Default: 120
		# Range: > 1
		reviveHakiCoatTicks = 120
		#Haki Coat amplifier after revive. 0 means level 1.
		# Default: 0
		# Range: 0 ~ 255
		reviveHakiCoatAmplifier = 0
		#Minimum spiritual health restored on revive as a percentage of max spiritual health.
		# Default: 0.5
		# Range: 0.0 ~ 1.0
		reviveSpiritualHealthRatio = 0.5
		#Minimum aura restored on revive as a percentage of max aura.
		# Default: 0.4
		# Range: 0.0 ~ 1.0
		reviveAuraRatio = 0.4
		#Minimum magicules restored on revive as a percentage of max magicules.
		# Default: 0.4
		# Range: 0.0 ~ 1.0
		reviveMagiculeRatio = 0.4

	#Obtainment settings for Schwi Ex Machina.
	[schwi_ex_machina.obtainment]
		#Magicule cost required to naturally acquire the skill.
		# Default: 350000.0
		# Range: 0.0 ~ 1.7976931348623157E308
		acquirementMagiculeCost = 350000.0
		#Starting mastery value when acquired.
		# Default: -1
		# Range: > -1
		acquirementMastery = -1
		#Maximum mastery value for Schwi Ex Machina.
		# Default: 2500
		# Range: > 1
		maxMastery = 2500
		#Required skill registry ID for obtainment. Empty string disables the required skill check.
		requiredSkillId = "tensura:mathematician"
		#If true, the required skill must be mastered before Schwi Ex Machina can be acquired.
		requiredSkillMustBeMastered = true

	#Magicule costs for each mode.
	[schwi_ex_machina.costs]
		#Magicule cost for Auto Shooting.
		# Default: 100
		# Range: > 0
		autoShootingCost = 100
		#Magicule cost for Lock.
		# Default: 100
		# Range: > 0
		lockCost = 100
		#Magicule cost for Continuous Fire checks.
		# Default: 100
		# Range: > 0
		continuousFireCost = 100
		#Magicule cost for Structural Analysis.
		# Default: 100
		# Range: > 0
		structuralAnalysisCost = 100
		#Magicule cost for Final Mode.
		# Default: 100
		# Range: > 0
		finalCost = 100

	#Calculation stack scaling.
	[schwi_ex_machina.calculation_stacks]
		#How often one calculation stack is gained while active.
		# Default: 2
		# Range: 1 ~ 72000
		stackIntervalTicks = 2
		#Maximum calculation stacks before mastery.
		# Default: 30
		# Range: 0 ~ 10000
		maxStacksBase = 30
		#Maximum calculation stacks when mastered.
		# Default: 40
		# Range: 0 ~ 10000
		maxStacksMastered = 40
		#Damage multiplier gained per stack. 0.02 = 2 percent per stack.
		# Default: 0.02
		# Range: 0.0 ~ 100.0
		damagePerStack = 0.02
		#Cooldown acceleration gained per stack.
		# Default: 0.1
		# Range: 0.0 ~ 100.0
		cooldownRatePerStack = 0.1

	#Cooldowns. 20 ticks = 1 second.
	[schwi_ex_machina.cooldowns]
		#Cooldown after Auto Shooting.
		# Default: 25
		# Range: > 0
		autoCooldownTicks = 25
		#Cooldown after Lock.
		# Default: 2
		# Range: > 0
		lockCooldownTicks = 2
		#Cooldown after Structural Analysis.
		# Default: 25
		# Range: > 0
		scanCooldownTicks = 25
		#Cooldown after Final Mode.
		# Default: 300
		# Range: > 0
		finalCooldownTicks = 300

	#Lock-on values.
	[schwi_ex_machina.lock]
		#How long Lock stays on the target.
		# Default: 800
		# Range: > 1
		lockDurationTicks = 800
		#Bonus damage against locked targets. 0.20 = 20 percent.
		# Default: 0.2
		# Range: 0.0 ~ 100.0
		lockDamageBonus = 0.2
		#Targeting range for Lock, Auto Shooting, Continuous Fire, and Structural Analysis.
		# Default: 70.0
		# Range: 1.0 ~ 512.0
		targetRange = 70.0
		#Glowing duration applied to locked targets.
		# Default: 200
		# Range: > 1
		lockGlowDurationTicks = 200
		#Movement Interference duration applied to locked targets.
		# Default: 120
		# Range: > 1
		lockMovementInterferenceDurationTicks = 120
		#Movement Interference amplifier applied to locked targets. 0 means level 1.
		# Default: 0
		# Range: 0 ~ 255
		lockMovementInterferenceAmplifier = 0

	#Auto Shooting values.
	[schwi_ex_machina.auto_shooting]
		#Auto Shooting duration before mastery.
		# Default: 240
		# Range: > 1
		autoDurationTicks = 240
		#Extra Auto Shooting duration when mastered.
		# Default: 120
		# Range: > 0
		autoMasteredBonusDurationTicks = 120
		#Delay between Auto Shooting volleys.
		# Default: 40
		# Range: > 1
		autoShotIntervalTicks = 40

	#Continuous Fire values.
	[schwi_ex_machina.continuous_fire]
		#How often Continuous Fire checks energy while held.
		# Default: 20
		# Range: > 1
		fireDrainCheckTicks = 20
		#Maximum ramp bonus outside Final Mode. 0.40 = 40 percent.
		# Default: 0.4
		# Range: 0.0 ~ 100.0
		fireMaxBonus = 0.4
		#Damage ramp gained per second while holding Continuous Fire.
		# Default: 0.05
		# Range: 0.0 ~ 100.0
		fireRampPerSecond = 0.05
		#Shot interval before 2 held seconds.
		# Default: 40
		# Range: > 1
		continuousFireIntervalStage0 = 40
