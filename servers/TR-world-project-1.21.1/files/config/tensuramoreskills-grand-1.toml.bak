		autoHitDamage = 1000.0
		#Base damage of Continuous Fire projectiles before ramp.
		# Default: 1000.0
		# Range: 0.0 ~ 3.4028234663852886E38
		fireBaseDamage = 1000.0
		#Secondary damage multiplier for fired bolts. 0.35 = 35 percent secondary damage.
		# Default: 0.35
		# Range: 0.0 ~ 100.0
		projectileSecondaryDamageMultiplier = 0.35
		#Fire ticks applied by fired bolts.
		# Default: 40
