		#Same target cannot be hit again by rain cubes inside this tick window.
		# Default: 9
		# Range: > 0
		cubeJudgementRainRecentHitTicks = 9
		#Maximum rain hits processed per tick before mastery. Keeps rain from lagging massive crowds.
		# Default: 6
