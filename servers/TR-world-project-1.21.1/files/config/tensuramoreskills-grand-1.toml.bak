		# Range: 0.0 ~ 1.7976931348623157E308
		endBlackHoleCost = 150000.0
		#Magicule cost for Avatar Beam. This is checked when the beam starts charging/releasing.
		# Default: 120000.0
		# Range: 0.0 ~ 1.7976931348623157E308
		avatarBeamCost = 120000.0

