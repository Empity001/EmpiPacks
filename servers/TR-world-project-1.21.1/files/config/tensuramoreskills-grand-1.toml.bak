		cubeJudgementGroundDespawnTicks = 20
		#How long cubes remain when no solid ground is found.
		# Default: 400
		# Range: > 0
		cubeJudgementNoGroundDespawnTicks = 400
		#Range used to send falling cube visuals to players. Higher values show farther but send to more clients.
		# Default: 280.0
		# Range: 1.0 ~ 4096.0
		cubeJudgementWatchRange = 280.0
		#Number of cubes in shift rain before mastery.
		# Default: 34
		# Range: 1 ~ 512
		cubeJudgementRainCubes = 34
		#Number of cubes in shift rain after mastery.
		# Default: 42
		# Range: 1 ~ 512
		cubeJudgementRainCubesMastered = 42
		#Base delay added between each rain cube.
		# Default: 2
		# Range: > 0
		cubeJudgementRainCubeDelayTicks = 2
		#Random extra delay spread for rain cubes.
		# Default: 8
		# Range: > 0
		cubeJudgementRainCubeDelayRandomTicks = 8
		#Extra lifetime added after rain cube fall/despawn time.
		# Default: 90
		# Range: > 0
		cubeJudgementRainExtraLifetimeTicks = 90
		#Same target cannot be hit again by the single cube inside this tick window.
		# Default: 12
		# Range: > 0
