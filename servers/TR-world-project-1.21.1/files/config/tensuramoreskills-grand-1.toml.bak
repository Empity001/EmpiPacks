		#Damage of each clone-added Stellas Natea spear before mastery.
		# Default: 6.0
		# Range: 0.0 ~ 3.4028234663852886E38
		cloneSpearDamage = 6.0
		#Damage of each clone-added Stellas Natea spear when mastered.
		# Default: 9.0
		# Range: 0.0 ~ 3.4028234663852886E38
		cloneSpearDamageMastered = 9.0

	[albis_vina.formula_succession]
		#If true, Ars Weiss clones mirror the user's magic casts while Albis Vina is toggled.
		formulaCloneCastingEnabled = true
		#If true, clones may mirror instant-cast magic. Usually false is safer.
		formulaAllowInstantMagic = false
		#Maximum number of Ars Weiss clones that may mirror one player magic cast.
		# Default: 3
		# Range: 0 ~ 64
		formulaMaxCloneCastsPerPlayerCast = 3
		#Magicule cost multiplier charged to the owner for each clone-cast magic.
		# Default: 0.35
		# Range: 0.0 ~ 100.0
		formulaCloneMagiculeCostMultiplier = 0.35
		#Aura cost multiplier charged to the owner for each clone-cast magic.
		# Default: 0.35
		# Range: 0.0 ~ 100.0
		formulaCloneAuraCostMultiplier = 0.35
		#Power multiplier for clone-cast magic when a custom damage hook supports it.
		# Default: 0.5
		# Range: 0.0 ~ 100.0
		formulaCloneCastPowerMultiplier = 0.5
		#If true, a clone shatters after finishing a mirrored magic cast.
		formulaConsumesCloneOnCast = false
		#If true, a clone shatters when its mirrored magic cast cannot be completed.
		formulaDestroyCloneOnFailedCast = false
		#Extra lifetime given to a clone when it starts mirroring a magic cast.
		# Default: 100
		# Range: > 0
		formulaCloneExtraLifeTicks = 100
		#Legacy cooldown value for old interrupted-cast Formula Succession logic.
		# Default: 12
		# Range: > 0
		formulaCooldownTicks = 12
		#Legacy minimum held ticks for old interrupted-cast Formula Succession logic.
		# Default: 5
		# Range: > 0
		formulaMinimumHeldTicks = 5
		#Legacy grace ticks for old interrupted-cast Formula Succession logic.
		# Default: 10
		# Range: 1 ~ 20
		formulaInterruptGraceTicks = 10
		#If true, staff casting can be mirrored by Ars Weiss clones.
		formulaAllowStaffCasting = false
		#If true, Formula Succession can mirror any skill tagged as Tensura magic.
		formulaAllowAllMagic = true
		#If true, summoning magic is allowed when Formula Succession is not restricted to all magic.
		formulaAllowSummoningMagic = true
		#If true, necromancy magic is allowed when Formula Succession is not restricted to all magic.
		formulaAllowNecromancyMagic = true
		#Spell registry IDs that Formula Succession is not allowed to mirror.
		formulaSuccessionBlacklist = ["tensura:megiddo", "tensura:spatial_storage", "tensura:warp_portal", "tensura:escape", "tensura:teleport", "tensura:gate"]

	[albis_vina.granted_package]
		#If true, Albis Vina grants the configured water and ice package when acquired, equipped, or toggled.
		grantPackageOnAcquire = true
		#If true, the grant package is retried when the skill is toggled.
		retryPackageGrantOnToggle = true
		#Skill registry IDs automatically granted with Albis Vina.
		grantedSkillIds = ["tensura:freeze", "tensura:icicle_lance", "tensura:icicle_spear", "tensura:icicle_rain", "tensura:ice_wall", "tensura:ice_blizzard", "tensura:ice_breaker", "tensura:water_aspectual", "tensura:drainage", "tensura:water_cutter_aspectual", "tensura:water_jail", "tensura:sleep_mist", "tensura:acid_shell", "tensura:water", "tensura:water_cutter", "tensura:acid_rain", "tensura:megiddo", "tensura:blizzard", "tensura:cold_resistance", "tensura:water_attack_resistance"]

	#Obtainment settings for Elfaria, the Hallowed Icemaiden.
	[elfaria_the_hallowed_icemaiden.obtainment]
		#Magicule cost required to naturally acquire the skill.
		# Default: 850000.0
		# Range: 0.0 ~ 1.7976931348623157E308
		acquirementMagiculeCost = 850000.0
		#Starting mastery value when acquired.
		# Default: 0
		# Range: > -1
		acquirementMastery = 0
		#Maximum mastery value.
		# Default: 2000
		# Range: > 1
		maxMastery = 2000
		#Required skill registry ID for obtainment.
		requiredSkillId = "tensuramoreskills:albis_vina"
		#If true, required skill must be mastered.
		requiredSkillMustBeMastered = true

	#Skills granted when this ultimate is acquired/toggled.
	[elfaria_the_hallowed_icemaiden.grant_package]
		#If true, grants the package below.
		grantPackageOnAcquire = true
		#If true, retries granting missing package skills on toggle/tick.
		retryPackageGrantOnToggle = true
		#Skill IDs granted by Elfaria. Includes Albis so old Ars Weiss clones stay compatible, magic basics, transforms, senses, chant annulment, and nullifications.
		grantedSkillIds = ["tensuramoreskills:albis_vina", "tensura:mana_manipulation", "tensura:magic_sense", "tensura:chant_annulment", "tensura:magic_water_transform", "tensura:magic_space_transform", "tensura:magic_wind_transform", "tensura:magic_earth_transform", "tensura:magic_flame_transform", "tensura:magic_light_transform", "tensura:magic_darkness_transform", "tensura:water_manipulation", "tensura:water_domination", "tensura:spatial_manipulation", "tensura:spatial_domination", "tensura:universal_perception", "tensura:analytical_appraisal", "tensura:magic_nullification", "tensura:water_attack_nullification", "tensura:cold_nullification", "tensura:thermal_fluctuation_nullification", "tensura:spiritual_attack_nullification", "tensura:abnormal_condition_nullification"]

